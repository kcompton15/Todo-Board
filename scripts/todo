#!/usr/bin/env bash
set -euo pipefail

TODO_URL="${TODO_URL:-http://127.0.0.1:7337}"
# Codex shells carry CODEX_THREAD_ID and Claude Code shells CLAUDECODE=1, so agents need no TODO_ACTOR prefix.
if [[ -n "${CODEX_THREAD_ID:-}" ]]; then default_actor=codex
elif [[ "${CLAUDECODE:-}" == 1 ]]; then default_actor=claude-code
else default_actor=cli
fi

die() { printf 'todo: %s\n' "$*" >&2; exit 1; }
down() { printf 'todo: board unreachable at %s (is the container running?)\n' "$TODO_URL" >&2; exit 3; }
need() { command -v "$1" >/dev/null 2>&1 || die "required command '$1' is not installed"; }
need curl
need jq

api() {
  local method="$1" path="$2" body="${3:-}" content_type="${4:-application/json}" revision="${5:-}"
  local response_file status
  response_file=$(mktemp "${TMPDIR:-/tmp}/todo-board.XXXXXX")
  local args=(-H "X-Actor: ${TODO_ACTOR:-$default_actor}" -sS --max-time 10 -o "$response_file" -w '%{http_code}' -X "$method" "$TODO_URL$path")
  [[ -z "$revision" ]] || args+=(-H "If-Match: $revision")
  if [[ -n "$body" ]]; then
    args+=(-H "Content-Type: $content_type" --data-binary "$body")
  fi
  if ! status=$(curl "${args[@]}" 2>/dev/null); then
    rm -f "$response_file"
    down
  fi
  if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
    local message
    message=$(jq -r '.error // empty' "$response_file" 2>/dev/null || true)
    [[ -n "$message" ]] || message=$(tr '\n' ' ' < "$response_file")
    rm -f "$response_file"
    die "${message:-request failed with HTTP $status}"
  fi
  cat "$response_file"
  rm -f "$response_file"
}

encode() { jq -rn --arg value "$1" '$value|@uri'; }

# JSON array of the arguments; read from stdin so values starting with '-' are never jq options.
json_args() {
  [[ $# -gt 0 ]] || { printf '[]'; return; }
  printf '%s\0' "$@" | jq -cRs 'split("\u0000") | .[:-1]'
}

# jq helpers: card and step handles fall back to IDs for servers without numbers.
JQ_REFS='def card_ref: if (.number // 0) > 0 then "#\(.number)" else .id end;
  def step_ref($card): if (.number // 0) > 0 and ($card // 0) > 0 then "#\($card).\(.number)" else .id end;'

# jq helpers: timestamps, idle days and the project key that matches directory names to board projects.
# A name matches a project when their keys are equal, or the name starts or ends with the project's key.
JQ_TIME='def epoch: capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.[0-9]+)?(?<z>Z|(?<s>[+-])(?<h>[0-9]{2}):(?<m>[0-9]{2}))$")
    | ((.d + "Z") | fromdateiso8601) - (if .z == "Z" then 0 else (if .s == "+" then 1 else -1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60) end);
  def known_time: . != null and . != "" and (startswith("0001") | not);
  def activity_epoch: (if (.activityAt | known_time) then .activityAt elif (.updatedAt | known_time) then .updatedAt else null end)
    | if . == null then null else epoch end;
  def idle_days: activity_epoch as $e | if $e == null then 0 else ((now - $e) / 86400 | floor) end;
  def pkey: ascii_downcase | gsub("[^a-z0-9]"; "");
  def is_mine($pk): $pk != "" and ((.project // "") | pkey) == $pk;
  def pick_project($explicit; $names):
    ([.tasks[].project // "" | select(. != "")] | unique) as $projects
    | if $explicit != "" then (first($projects[] | select(pkey == ($explicit | pkey))) // $explicit)
      else (first($names[] | pkey as $k | select($k != "") | $projects[] | select(pkey == $k))
        // first($names[] | pkey as $k | select($k != "")
          | [$projects[] | pkey as $p | select(($p | length) >= 3 and (($k | startswith($p)) or ($k | endswith($p))))]
          | sort_by(-(pkey | length)) | .[0] // empty)
        // "")
      end;'

resolve_task() {
  local prefix="$1" matches count number
  if [[ "$prefix" =~ ^#?([0-9]{1,9})$ ]]; then
    number=$((10#${BASH_REMATCH[1]}))
    matches=$(api GET /api/tasks | jq -r --argjson number "$number" '.tasks[] | select(.number == $number) | .id')
    [[ -n "$matches" ]] || die "no task #$number"
    printf '%s' "$matches"
    return
  fi
  if [[ "$prefix" =~ ^#?[0-9]+\.[0-9]+$ ]]; then
    die "'$prefix' is a step; pass the card and step separately, for example: todo check 142 3"
  fi
  matches=$(api GET /api/tasks | jq -r --arg prefix "$prefix" '.tasks[].id | select(startswith($prefix))')
  count=$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')
  case "$count" in
    0) die "no task matches '$prefix'" ;;
    1) printf '%s' "$matches" ;;
    *) die "task prefix '$prefix' is ambiguous: $(printf '%s' "$matches" | tr '\n' ' ')" ;;
  esac
}

resolve_subtask() {
  local task_id="$1" prefix="$2" matches count card="" step="" task
  if [[ "$prefix" =~ ^#?([0-9]{1,9})\.([0-9]{1,9})$ ]]; then
    card=$((10#${BASH_REMATCH[1]})); step=$((10#${BASH_REMATCH[2]}))
  elif [[ "$prefix" =~ ^#?([0-9]{1,9})$ ]]; then
    step=$((10#${BASH_REMATCH[1]}))
  fi
  if [[ -n "$step" ]]; then
    task=$(api GET "/api/tasks/$task_id")
    if [[ -n "$card" && "$(printf '%s' "$task" | jq -r '.number // 0')" != "$card" ]]; then
      die "step '$prefix' is not on card $(printf '%s' "$task" | jq -r "$JQ_REFS card_ref")"
    fi
    matches=$(printf '%s' "$task" | jq -r --argjson step "$step" '.subtasks[] | select(.number == $step) | .id')
    [[ -n "$matches" ]] || die "no step $step on card $(printf '%s' "$task" | jq -r "$JQ_REFS card_ref")"
    printf '%s' "$matches"
    return
  fi
  matches=$(api GET "/api/tasks/$task_id" | jq -r --arg prefix "$prefix" '.subtasks[].id | select(startswith($prefix))')
  count=$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')
  case "$count" in
    0) die "no subtask matches '$prefix'" ;;
    1) printf '%s' "$matches" ;;
    *) die "subtask prefix '$prefix' is ambiguous: $(printf '%s' "$matches" | tr '\n' ' ')" ;;
  esac
}

card_ref() { api GET "/api/tasks/$1" | jq -r "$JQ_REFS card_ref"; }

# TODO_PROJECT, then the nearest .todo-project file, names a directory's project outright.
explicit_project() {
  local d="$1"
  if [[ -n "${TODO_PROJECT:-}" ]]; then printf '%s' "$TODO_PROJECT"; return; fi
  while [[ -n "$d" && "$d" != "/" ]]; do
    if [[ -f "$d/.todo-project" ]]; then
      sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$d/.todo-project"
      return
    fi
    d=$(dirname "$d")
  done
}

# JSON array of names to match against board projects, nearest first: each directory up to $HOME,
# with the git origin's repository name right after the repository's top level.
project_names() {
  local dir top origin home d names=()
  dir=$(cd "$1" 2>/dev/null && pwd -P) || { printf '[]'; return; }
  home=$(cd "$HOME" 2>/dev/null && pwd -P) || home="$HOME"
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || top=""
  origin=$(git -C "$dir" remote get-url origin 2>/dev/null) || origin=""
  origin=${origin%.git}; origin=${origin##*[/:]}
  d="$dir"
  while [[ -n "$d" && "$d" != "/" && "$d" != "$home" ]]; do
    names+=("${d##*/}")
    if [[ -n "$origin" && "$d" == "$top" ]]; then names+=("$origin"); origin=""; fi
    d=$(dirname "$d")
  done
  [[ -z "$origin" ]] || names+=("$origin")
  json_args ${names[@]+"${names[@]}"}
}

# Prints the board project for a directory, or nothing. Never invents a name the board lacks.
resolve_project() {
  local dir="$1" tasks="$2"
  printf '%s' "$tasks" | jq -r --arg explicit "$(explicit_project "$dir")" --argjson names "$(project_names "$dir")" \
    "$JQ_TIME"' pick_project($explicit; $names)'
}

# Prints "start end" in Chicago dates, matching the board's report dialog defaults.
report_dates() {
  TZ=America/Chicago jq -rn --arg kind "$1" '
    (now | localtime) as $t | ([$t[0], $t[1], $t[2], 12, 0, 0, 0, 0] | mktime) as $today |
    def day($offset): ($today + $offset * 86400) | strftime("%Y-%m-%d");
    if $kind == "standup" then
      "\(day(-(if $t[6] == 1 then 3 elif $t[6] == 0 then 2 else 1 end))) \(day(0))"
    else (-((($t[6] + 6) % 7) + 7)) as $start | "\(day($start)) \(day($start + 6))" end'
}

report_worker_silence() {
  jq -r --argjson fresh 30 "$JQ_TIME"'
    if .lastClaimAt == null then "the report writer has not checked in since the board started"
    else (now - (.lastClaimAt | epoch)) as $age
      | if $age < $fresh then empty else "the report writer last checked in \($age | floor) s ago" end
    end'
}

report_fallback() {
  printf '%s\n' "$2"
  printf 'todo: %s; printed the evidence digest instead\n' "$1" >&2
  exit 4
}

print_table() {
  jq -r "$JQ_REFS"'
    if (.tasks|length)==0 then "No tasks found."
    else (["#","LANE","P","KIND","PROJECT","TITLE"], (.tasks[] | [(if (.number // 0) > 0 then card_ref else .id[0:12] end),.lane,(.priority|tostring),(.kind//"work"),(.project//""),.title]))
    | @tsv end' | awk -F '\t' 'BEGIN{OFS="  "} {printf "%-6s  %-8s  %-2s  %-8s  %-18s  %s\n",$1,$2,$3,$4,$5,$6}'
}

usage() {
  cat <<'EOF'
todo health
todo ls [--lane L] [--project P] [--tag T] [--kind K] [--json]
todo find "words" [--json]   (any word matches; best first, top 10)
todo add "title" [--lane L] [--kind work|followup|review|probe]
         [--prio 1|2|3] [--project P] [--tag T]
         (without --project, the card files under this directory's project; see todo project)
         [--source S] [--notes TEXT] [--sub TEXT]...
todo show <card> [--json]
todo move <card> <backlog|today|doing|blocked|done>
todo kind <card> <work|followup|review|probe>
todo link <card> <key|url> [--sub <prefix>] [--role required|reference]
todo unlink <card> <link-prefix>
todo reconcile <card> automatic|manual
todo memo <card> <text>
todo start <card>
todo done <card>
todo block <card> [reason]
todo sub <card> "title" [--lane L]
todo submove <card> <step> <lane>
todo check|uncheck <card> <step>
todo rm <card>
todo import [file]
todo ops [file]
todo context [--cwd DIR]
todo project [--cwd DIR]   (the board project for a directory: TODO_PROJECT, the nearest
                            .todo-project file, else a directory or git repo name the board knows)
todo stale [--days N] [--json]   (open cards with no real activity for N days, default 7)
todo history [card] [--json]
todo log <card> <progress|decision|blocker|blocker_resolved|next_step|review_delivered> "text" [--sub <step>]
todo report standup|weekly [--from YYYY-MM-DD] [--to YYYY-MM-DD] [--project P]...
  (prints Claude's talking points; if the report writer is not running, fails,
   or takes over 3 minutes, prints the evidence digest and exits 4)
todo add also accepts [--link KEY_OR_URL]... [--agent-context TEXT] [--new]
  (an open card that already covers a Jira key or MR gets a new step instead;
   --new always creates a separate card)

<card> is a number (142 or '#142') or a task ID prefix.
<step> is a step number (3 or '#142.3') or a subtask ID prefix.

Environment: TODO_URL (default http://127.0.0.1:7337), TODO_ACTOR (default codex or
  claude-code inside those agents' shells, otherwise cli; todo add --source also sets it),
  TODO_PROJECT (overrides this directory's project),
  TODO_REPORT_TIMEOUT (seconds todo report waits, default 180)
EOF
}

command_name="${1:-}"
[[ -n "$command_name" ]] && shift || true

case "$command_name" in
  health)
    api GET /healthz
    ;;
  ls)
    lane="" project="" tag="" kind="" json=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lane) [[ $# -ge 2 ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
        --project) [[ $# -ge 2 ]] || die "--project requires a value"; project="$2"; shift 2 ;;
        --tag) [[ $# -ge 2 ]] || die "--tag requires a value"; tag="$2"; shift 2 ;;
        --kind) [[ $# -ge 2 ]] || die "--kind requires a value"; kind="$2"; shift 2 ;;
        --json) json=true; shift ;;
        *) die "unknown ls option '$1'" ;;
      esac
    done
    query="?"
    [[ -n "$lane" ]] && query+="lane=$(encode "$lane")&"
    [[ -n "$project" ]] && query+="project=$(encode "$project")&"
    [[ -n "$tag" ]] && query+="tag=$(encode "$tag")&"
    [[ -n "$kind" ]] && query+="kind=$(encode "$kind")&"
    result=$(api GET "/api/tasks$query")
    if $json; then printf '%s\n' "$result" | jq .; else printf '%s\n' "$result" | print_table; fi
    ;;
  find)
    [[ $# -ge 1 ]] || die "find requires search text"
    text="$1"; shift; json=false
    [[ "${1:-}" == "--json" ]] && json=true && shift
    [[ $# -eq 0 ]] || die "unexpected find argument '$1'"
    result=$(api GET "/api/tasks?q=$(encode "$text")")
    count=$(printf '%s' "$result" | jq '.tasks|length')
    [[ "$count" -gt 0 ]] || { printf 'No matching tasks.\n' >&2; exit 1; }
    if $json; then printf '%s\n' "$result" | jq .; else
      printf '%s\n' "$result" | jq '{tasks: .tasks[0:10]}' | print_table
      [[ "$count" -le 10 ]] || printf '+%d more matches (todo find "%s" --json)\n' "$((count - 10))" "$text"
    fi
    ;;
  add)
    [[ $# -ge 1 ]] || die "add requires a title"
    title="$1"; shift; lane=""; kind="work"; priority=2; project=""; project_given=false; tag=""; notes=""; source="$default_actor"; subs=(); links='[]'; memo=""; on_match="attach"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --new) on_match="create"; shift ;;
        --lane) [[ $# -ge 2 ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
        --kind) [[ $# -ge 2 ]] || die "--kind requires a value"; kind="$2"; shift 2 ;;
        --prio|--priority) [[ $# -ge 2 ]] || die "$1 requires a value"; priority="$2"; shift 2 ;;
        --project) [[ $# -ge 2 ]] || die "--project requires a value"; project="$2"; project_given=true; shift 2 ;;
        --tag) [[ $# -ge 2 ]] || die "--tag requires a value"; tag="$2"; shift 2 ;;
        --notes) [[ $# -ge 2 ]] || die "--notes requires a value"; notes="$2"; shift 2 ;;
        --source) [[ $# -ge 2 ]] || die "--source requires a value"; source="$2"; shift 2 ;;
        --sub) [[ $# -ge 2 ]] || die "--sub requires a value"; subs+=("$2"); shift 2 ;;
        --link) [[ $# -ge 2 ]] || die "--link requires a value"; links=$(jq -cn --argjson links "$links" --arg ref "$2" '$links+[{ref:$ref}]'); shift 2 ;;
        --agent-context) [[ $# -ge 2 ]] || die "--agent-context requires a value"; memo="$2"; shift 2 ;;
        *) die "unknown add option '$1'" ;;
      esac
    done
    sub_json='[]'
    if [[ ${#subs[@]} -gt 0 ]]; then
      sub_json=$(json_args "${subs[@]}")
    fi
    [[ -n "${TODO_ACTOR:-}" ]] || TODO_ACTOR="$source"
    if ! $project_given && ! project=$(resolve_project "$PWD" "$(api GET /api/tasks)"); then
      printf 'todo: could not work out this directory'"'"'s project; filing without one\n' >&2
      project=""
    fi
    body=$(jq -n --arg title "$title" --arg lane "$lane" --arg kind "$kind" --argjson priority "$priority" --arg project "$project" --arg tag "$tag" --arg notes "$notes" --arg source "$source" --argjson subtasks "$sub_json" '{title:$title,lane:$lane,kind:$kind,priority:$priority,project:$project,tag:$tag,notes:$notes,source:$source,subtasks:$subtasks}')
    body=$(printf '%s' "$body" | jq --argjson links "$links" --arg memo "$memo" '.+{links:$links,agentContext:$memo} | if .lane=="" then del(.lane) else . end')
    api POST "/api/tasks?onMatch=$on_match" "$body" | jq -r "$JQ_REFS"'
      if .attached then .task.number as $card | "attached to \(.task | card_ref) (\(.task.title)) as \(.subtask | step_ref($card))"
      else .tasks[0] | "created \(card_ref) [\(.lane)] \(.title)" + (if (.project // "") == "" then "" else "  {\(.project)}" end) end'
    ;;
  show)
    [[ $# -ge 1 ]] || die "show requires a task id"
    id=$(resolve_task "$1"); shift; json=false
    [[ "${1:-}" == "--json" ]] && json=true && shift
    [[ $# -eq 0 ]] || die "unexpected show argument '$1'"
    result=$(api GET "/api/tasks/$id")
    if $json; then printf '%s\n' "$result" | jq .; else
      printf '%s\n' "$result" | jq -r "$JQ_REFS"'.number as $card | "\(card_ref)  \(.id)  [\(.lane)] P\(.priority)  \(.title)\nkind: \(.kind // "work")  project: \(.project // "")  tag: \(.tag // "")  source: \(.source)\nnotes: \(.notes // "")\nsubtasks:\n" + ((.subtasks // []) | map("  [" + (if .done then "x" else " " end) + "] [\(.lane)] \(step_ref($card))  \(.id)  \(.title)") | join("\n"))'
      printf '%s\n' "$result" | jq -r '"reconciliation: \(.reconcileMode // "automatic")\nagent memo: \(.agentContext // "")", (.links[]? | "link \(.id): \(.ref) [\(.role)] scope=\(.subtaskId // "card") state=\(.state // "unknown") \(.url)")'
    fi
    ;;
  move|start|done)
    [[ $# -ge 1 ]] || die "$command_name requires a task id"
    id=$(resolve_task "$1")
    if [[ "$command_name" == "move" ]]; then [[ $# -eq 2 ]] || die "move requires a lane"; lane="$2"; else [[ $# -eq 1 ]] || die "unexpected argument"; [[ "$command_name" == "start" ]] && lane="doing" || lane="done"; fi
    body=$(jq -n --arg lane "$lane" '{lane:$lane}')
    api PATCH "/api/tasks/$id" "$body" | jq -r "$JQ_REFS"'"moved \(card_ref) to \(.lane)"'
    ;;
  link)
    [[ $# -ge 2 ]] || die "link requires card and key or URL"
    id=$(resolve_task "$1"); ref="$2"; shift 2; sub=""; role=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --sub) [[ $# -ge 2 ]] || die "--sub requires prefix"; sub=$(resolve_subtask "$id" "$2"); shift 2 ;;
        --role) [[ $# -ge 2 ]] || die "--role requires role"; role="$2"; shift 2 ;;
        *) die "unknown link option '$1'" ;;
      esac
    done
    current=$(api GET "/api/tasks/$id")
    body=$(jq -n --arg ref "$ref" --arg sub "$sub" --arg role "$role" '{ref:$ref,subtaskId:$sub} + (if $role=="" then {} else {role:$role} end)')
    api POST "/api/tasks/$id/links" "$body" application/json "$(printf '%s' "$current" | jq -r .revision)" | jq -r '"linked \(.id) \(.ref) [\(.role)]"'
    ;;
  unlink)
    [[ $# -eq 2 ]] || die "unlink requires card and link prefix"
    id=$(resolve_task "$1"); current=$(api GET "/api/tasks/$id")
    matches=$(printf '%s' "$current" | jq --arg prefix "$2" '[.links[].id | select(startswith($prefix))]')
    [[ $(printf '%s' "$matches" | jq length) -eq 1 ]] || die "link prefix '$2' must match exactly one link"
    link_id=$(printf '%s' "$matches" | jq -r '.[0]')
    api DELETE "/api/tasks/$id/links/$link_id" "" application/json "$(printf '%s' "$current" | jq -r .revision)" | jq -r '"unlinked \(.deleted)"'
    ;;
  reconcile|memo)
    [[ $# -eq 2 ]] || die "$command_name requires card and value"
    id=$(resolve_task "$1"); current=$(api GET "/api/tasks/$id"); field=agentContext
    [[ "$command_name" != reconcile ]] || field=reconcileMode
    body=$(jq -n --arg field "$field" --arg value "$2" '{($field):$value}')
    api PATCH "/api/tasks/$id" "$body" application/json "$(printf '%s' "$current" | jq -r .revision)" | jq -r "$JQ_REFS"'"updated \(card_ref)"'
    ;;
  kind)
    [[ $# -eq 2 ]] || die "kind requires task id and kind"
    case "$2" in work|followup|review|probe) ;; *) die "invalid kind '$2'" ;; esac
    id=$(resolve_task "$1"); kind="$2"
    current=$(api GET "/api/tasks/$id")
    body=$(jq -n --arg kind "$kind" '{kind:$kind}')
    api PATCH "/api/tasks/$id" "$body" application/json "$(printf '%s' "$current" | jq -r .revision)" | jq -r "$JQ_REFS"'"kind \(card_ref) -> \(.kind)"'
    ;;
  block)
    [[ $# -ge 1 && $# -le 2 ]] || die "block requires a task id and optional reason"
    id=$(resolve_task "$1"); reason="${2:-}"
    current=$(api GET "/api/tasks/$id")
    body=$(printf '%s' "$current" | jq --arg reason "$reason" '{lane:"blocked",notes:(if $reason=="" then .notes else ((if .notes=="" then "" else .notes+"\n\n" end)+"Blocked: "+$reason) end)}')
    api PATCH "/api/tasks/$id" "$body" application/json "$(printf '%s' "$current" | jq -r .revision)" | jq -r "$JQ_REFS"'"blocked \(card_ref)"'
    ;;
  sub)
    [[ $# -ge 2 ]] || die "sub requires a task id and title"
    id=$(resolve_task "$1"); title="$2"; shift 2; lane=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lane) [[ $# -ge 2 ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
        *) die "unknown sub option '$1'" ;;
      esac
    done
    body=$(jq -n --arg title "$title" --arg lane "$lane" '{title:$title} + (if $lane=="" then {} else {lane:$lane} end)')
    card=$(api GET "/api/tasks/$id" | jq '.number // 0')
    api POST "/api/tasks/$id/subtasks" "$body" | jq -r --argjson card "$card" "$JQ_REFS"'"created \(step_ref($card)) [\(.lane)] \(.title)"'
    ;;
  submove)
    [[ $# -eq 3 ]] || die "submove requires task id, subtask id, and lane"
    id=$(resolve_task "$1"); subtask_id=$(resolve_subtask "$id" "$2")
    body=$(jq -n --arg lane "$3" '{lane:$lane}')
    card=$(api GET "/api/tasks/$id" | jq '.number // 0')
    api PATCH "/api/tasks/$id/subtasks/$subtask_id" "$body" | jq -r --argjson card "$card" "$JQ_REFS"'"moved \(step_ref($card)) to \(.lane)"'
    ;;
  check|uncheck)
    [[ $# -eq 2 ]] || die "$command_name requires task and subtask ids"
    id=$(resolve_task "$1"); subtask_id=$(resolve_subtask "$id" "$2")
    [[ "$command_name" == "check" ]] && done=true || done=false
    card=$(api GET "/api/tasks/$id" | jq '.number // 0')
    api PATCH "/api/tasks/$id/subtasks/$subtask_id" "{\"done\":$done}" | jq -r --argjson card "$card" "$JQ_REFS"'"updated \(step_ref($card))  \(.title)"'
    ;;
  rm)
    [[ $# -eq 1 ]] || die "rm requires a task id"
    id=$(resolve_task "$1"); ref=$(card_ref "$id"); api DELETE "/api/tasks/$id" >/dev/null; printf 'deleted %s (%s)\n' "$ref" "$id"
    ;;
  import)
    [[ $# -le 1 ]] || die "import accepts at most one file"
    if [[ $# -eq 1 ]]; then body=$(<"$1"); else body=$(cat); fi
    trimmed="${body#"${body%%[![:space:]]*}"}"
    if [[ "$trimmed" == \[* ]]; then content_type="application/json"; else content_type="text/plain"; fi
    api POST /api/import "$body" "$content_type" | jq -r '"created \(.created) task(s)" + (if ((.attachments // []) | length) > 0 then ", attached \(.attachments | length) to existing cards" else "" end)'
    ;;
  ops)
    [[ $# -le 1 ]] || die "ops accepts at most one file"
    if [[ $# -eq 1 ]]; then body=$(<"$1"); else body=$(cat); fi
    api POST /api/ops "$body" | jq -r '"applied \(.applied) operation(s)"'
    ;;
  history)
    id="" json=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --json) json=true; shift ;;
        *) [[ -z "$id" ]] || die "history accepts one task id"; id=$(resolve_task "$1"); shift ;;
      esac
    done
    result=$(api GET "/api/activity?limit=50&taskId=$(encode "$id")")
    if $json; then printf '%s\n' "$result" | jq .; else
      printf '%s\n' "$result" | jq -r '.activity[] | "\(.at)  \(.actor)  \(.action)  \(.title) (r\(.revision))", (.changes[] | "  \(.field): \(.before) -> \(.after)")'
    fi
    ;;
  log)
    [[ $# -ge 3 ]] || die "log requires task id, kind, and text"
    id=$(resolve_task "$1"); kind="$2"; text="$3"; shift 3; sub=""
    if [[ $# -gt 0 ]]; then [[ $# -eq 2 && "$1" == --sub ]] || die "expected --sub prefix"; sub=$(resolve_subtask "$id" "$2"); fi
    case "$kind" in progress|decision|blocker|blocker_resolved|next_step|review_delivered) ;; *) die "invalid work-log kind '$kind'" ;; esac
    current=$(api GET "/api/tasks/$id")
    body=$(jq -n --arg kind "$kind" --arg text "$text" --arg sub "$sub" '{kind:$kind,text:$text,subtaskId:$sub}')
    api POST "/api/tasks/$id/work-log" "$body" application/json "$(printf '%s' "$current" | jq -r .revision)" | jq -r --arg ref "$(printf '%s' "$current" | jq -r "$JQ_REFS card_ref")" '"logged \(.kind) on \($ref)"'
    ;;
  report)
    [[ $# -ge 1 ]] || die "report requires standup or weekly"
    kind="$1"; shift
    case "$kind" in standup|weekly) ;; *) die "invalid report kind '$kind' (standup or weekly)" ;; esac
    dates=$(report_dates "$kind"); from="${dates% *}"; to="${dates#* }"
    projects='[]'
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --from) [[ $# -ge 2 ]] || die "--from requires a date"; from="$2"; shift 2 ;;
        --to) [[ $# -ge 2 ]] || die "--to requires a date"; to="$2"; shift 2 ;;
        --project) [[ $# -ge 2 ]] || die "--project requires a value"; projects=$(jq -cn --argjson projects "$projects" --arg project "$2" '$projects+[$project]'); shift 2 ;;
        *) die "unknown report option '$1'" ;;
      esac
    done
    timeout="${TODO_REPORT_TIMEOUT:-180}"
    [[ "$timeout" =~ ^[0-9]+$ ]] || die "TODO_REPORT_TIMEOUT must be a whole number of seconds"
    body=$(jq -cn --arg kind "$kind" --arg start "$from" --arg end "$to" --argjson projects "$projects" '{kind:$kind,start:$start,end:$end,projects:$projects}')
    worker=$(api GET /api/reports/worker)
    silence=$(printf '%s' "$worker" | report_worker_silence)
    if [[ -n "$silence" ]]; then
      digest=$(api POST /api/reports/preview "$body" | jq -r .markdown)
      report_fallback "$silence (start it with scripts/install-todo-reporter --enable)" "$digest"
    fi
    job=$(api POST /api/reports/jobs "$body")
    id=$(printf '%s' "$job" | jq -r .id)
    digest=$(printf '%s' "$job" | jq -r .digestMarkdown)
    deadline=$((SECONDS + timeout))
    while :; do
      state=$(printf '%s' "$job" | jq -r .state)
      case "$state" in
        done) printf '%s\n' "$job" | jq -r .markdown; exit 0 ;;
        failed) report_fallback "the report writer failed: $(printf '%s' "$job" | jq -r '.error // "no reason given"')" "$digest" ;;
      esac
      [[ $SECONDS -lt $deadline ]] || report_fallback "no report after ${timeout} s; the writer may be stuck (see ~/.local/log/todo-reporter.log)" "$digest"
      sleep 1
      if job=$(api GET "/api/reports/jobs/$(encode "$id")"); then :; else
        status=$?
        [[ $status -ne 3 ]] || exit 3
        report_fallback "the board lost report job $id" "$digest"
      fi
    done
    ;;
  project)
    dir="$PWD"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cwd) [[ $# -ge 2 ]] || die "--cwd requires a directory"; dir="$2"; shift 2 ;;
        *) die "unknown project option '$1'" ;;
      esac
    done
    project=$(resolve_project "$dir" "$(api GET /api/tasks)")
    [[ -n "$project" ]] || die "no board project matches $dir; put a project name in a .todo-project file there to set one"
    printf '%s\n' "$project"
    ;;
  stale)
    days=7 json=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --days) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--days requires a whole number"; days="$2"; shift 2 ;;
        --json) json=true; shift ;;
        *) die "unknown stale option '$1'" ;;
      esac
    done
    result=$(api GET /api/tasks | jq --argjson days "$days" "$JQ_TIME"'
      {tasks: ([.tasks[] | select(.lane != "done") | . + {idleDays: idle_days} | select(.idleDays >= $days)] | sort_by(-.idleDays))}')
    if $json; then printf '%s\n' "$result"; exit 0; fi
    if [[ $(printf '%s' "$result" | jq '.tasks | length') -eq 0 ]]; then
      printf 'No open cards idle %s+ days.\n' "$days"
      exit 0
    fi
    printf '%s' "$result" | jq -r "$JQ_REFS"'
      (["#","LANE","IDLE","KIND","PROJECT","TITLE"], (.tasks[] | [card_ref, .lane, "\(.idleDays)d", (.kind // "work"), (.project // ""), .title])) | @tsv' |
      awk -F '\t' '{printf "%-6s  %-8s  %-5s  %-8s  %-18s  %s\n",$1,$2,$3,$4,$5,$6}'
    ;;
  context)
    dir="$PWD"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cwd) [[ $# -ge 2 ]] || die "--cwd requires a directory"; dir="$2"; shift 2 ;;
        *) die "unknown context option '$1'" ;;
      esac
    done
    api GET /api/tasks | jq -r --argjson budget 1900 --argjson reserve 500 --argjson idle 7 \
      --arg explicit "$(explicit_project "$dir")" --argjson names "$(project_names "$dir")" "$JQ_REFS $JQ_TIME"'
      def is_active:
        ((.lane != "done" and .lane != "backlog")
          or (.lane == "done" and any(.subtasks[]?; .lane != "done"))
          or any(.subtasks[]?; .lane != "done" and .lane != "backlog"));
      def is_probe: (.kind // "work") == "probe";
      def card_block:
        . as $task |
        [.subtasks[]? | select(.lane != "done")] as $open |
        ("- [\($task.lane)] "
          + (if ($task.kind // "work") == "work" then "" else "[\($task.kind)] " end)
          + "\($task | card_ref)  \($task.title)"
          + (if ($task.project // "") != "" then "  {\($task.project)}" else "" end)
          + (($task | idle_days) as $days | if $days >= $idle then "  (idle \($days)d)" else "" end))
        + (if ($open | length) == 0 then ""
          else "\n" + (
            ([$open[0:3][] | "    - [ ] [\(.lane)] \(step_ref($task.number))  \(.title)"])
            + (if ($open | length) > 3
              then ["    - +\(($open | length) - 3) more open steps"]
              else []
              end)
            | join("\n")
          )
          end);
      def also_line:
        "- \(card_ref) "
          + (if (.title | length) > 64 then .title[0:61] + "..." else .title end)
          + (if (.project // "") != "" then " {\(.project)}" else "" end);
      def fill($limit; $items; more):
        reduce range(0; $items | length) as $i (
          {text: ., stopped: false};
          if .stopped then .
          else
            (.text + "\n" + $items[$i]) as $candidate |
            (($items | length) - $i - 1) as $after |
            (if $after == 0 then $candidate else $candidate + "\n" + ($after | more) end) as $preview |
            if (($preview | utf8bytelength) + 1) <= $limit then .text = $candidate
            else {text: (.text + "\n" + ((($items | length) - $i) | more)), stopped: true}
            end
          end
        ) | .text;
      def recent_first: sort_by(-(activity_epoch // 0));
      pick_project($explicit; $names) as $project |
      ($project | pkey) as $pk |
      [.tasks[] | select(is_active) | select(is_probe | not)] as $active_cards |
      ([$active_cards[] | select(is_mine($pk))] | recent_first) as $mine |
      ([$active_cards[] | select(is_mine($pk) | not) | select(idle_days < $idle)] | recent_first) as $fresh |
      ([$active_cards[] | select(is_mine($pk) | not) | select(idle_days >= $idle)] | length) as $idle_count |
      [($mine + $fresh)[] | card_block] as $blocks |
      (if $idle_count == 0 then ""
        else "- \($idle_count) card\(if $idle_count == 1 then "" else "s" end) idle \($idle)+ days"
          + (if $pk == "" then "" else " in other projects" end) + " (todo stale)"
        end) as $idle_line |
      (if $idle_line == "" then 0 else ($idle_line | utf8bytelength) + 1 end) as $idle_bytes |
      [.tasks[] | select(.lane != "done") | select(is_probe or (.lane == "backlog" and (is_active | not)))]
        | sort_by([(if is_mine($pk) then 0 else 1 end), -(activity_epoch // 0)]) | map(also_line) as $also |
      "Also open (backlog/probe):" as $also_header |
      (if ($also | length) == 0 then 0
        else ([(($also_header + "\n" + ($also | join("\n"))) | utf8bytelength) + 1, $reserve] | min)
        end) as $held |
      (if $project == "" then "## Task board" else "## Task board for {\($project)} (this directory)" end) as $title |
      (if ($blocks | length) == 0 then $title + ": nothing active" + (if $idle_count > 0 then " recently." else "." end)
        else ($title + ": update these instead of creating duplicates")
          | fill($budget - $held - $idle_bytes; $blocks; "- +\(.) more active cards (todo ls)")
        end
        | if $idle_line == "" then . else . + "\n" + $idle_line end) as $active_text |
      if ($also | length) == 0 or ((($active_text + "\n" + $also_header) | utf8bytelength) + 1) > $budget then $active_text
      else ($active_text + "\n" + $also_header) | fill($budget; $also; "- +\(.) more backlog/probe cards (todo ls --lane backlog, todo ls --kind probe)")
      end'
    ;;
  help|-h|--help|"") usage ;;
  *) die "unknown command '$command_name' (try: todo help)" ;;
esac
