#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'install-board-notifier: %s\n' "$*" >&2
  exit 1
}

usage() {
  die "usage: scripts/install-board-notifier [--uninstall] [--label L]"
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command '$1' is not installed"
}

xml_escape() {
  local value=$1
  value=${value//&/&amp;}
  value=${value//</&lt;}
  value=${value//>/&gt;}
  value=${value//\"/&quot;}
  value=${value//\'/&apos;}
  printf '%s' "$value"
}

uninstall=false
label="${BOARD_NOTIFIER_LABEL:-io.github.kcompton15.board-notifier}"
while (($#)); do
  case "$1" in
    --uninstall) uninstall=true ;;
    --label)
      (($# >= 2)) || usage
      label=$2
      shift
      ;;
    *) usage ;;
  esac
  shift
done
[[ "$label" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*\.board-notifier$ ]] || die "--label must be a reverse-DNS name ending in .board-notifier"

for command in curl jq osascript launchctl plutil; do
  need "$command"
done

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repo_dir=$(cd "$script_dir/.." && pwd -P)
notifier="$script_dir/board-notifier"
[[ -x "$notifier" ]] || die "notifier is not executable: $notifier"

domain="gui/$(id -u)"
service="$domain/$label"
launch_agents="$HOME/Library/LaunchAgents"
plist="$launch_agents/$label.plist"
log_dir="$HOME/.local/log"
log_file="$log_dir/board-notifier.log"
todo_url="${TODO_URL:-http://127.0.0.1:7337}"
todo_url="${todo_url%/}"
[[ "$todo_url" =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?$ ]] || die "TODO_URL must be a loopback http origin"

for other in "$launch_agents"/*.board-notifier.plist; do
  [[ -e "$other" && "$other" != "$plist" ]] || continue
  die "another notifier agent is installed at $other; pass --label $(basename "$other" .plist) to manage that one"
done

if [[ "$uninstall" == true ]]; then
  if launchctl print "$service" >/dev/null 2>&1; then
    launchctl bootout "$service"
  fi
  rm -f -- "$plist"
  printf 'removed %s\n' "$label"
  exit 0
fi

mkdir -p "$launch_agents" "$log_dir"
temporary_plist=$(mktemp "$launch_agents/.board-notifier.XXXXXX")
trap 'rm -f "$temporary_plist"' EXIT

weekday_entries=""
for weekday in 1 2 3 4 5; do
  weekday_entries+="    <dict><key>Weekday</key><integer>$weekday</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>"$'\n'
done

cat >"$temporary_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array><string>$(xml_escape "$notifier")</string></array>
  <key>WorkingDirectory</key><string>$(xml_escape "$repo_dir")</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TODO_URL</key><string>$(xml_escape "$todo_url")</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
$weekday_entries  </array>
  <key>StandardOutPath</key><string>$(xml_escape "$log_file")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$log_file")</string>
</dict>
</plist>
EOF
plutil -lint "$temporary_plist" >/dev/null || die "generated plist failed plutil -lint"

if launchctl print "$service" >/dev/null 2>&1; then
  launchctl bootout "$service"
fi
chmod 0644 "$temporary_plist"
mv -f "$temporary_plist" "$plist"
launchctl bootstrap "$domain" "$plist"
launchctl print "$service" >/dev/null || die "agent missing after bootstrap"
printf 'installed %s\nplist: %s\nprogram: %s\nlog: %s\n' "$label" "$plist" "$notifier" "$log_file"
